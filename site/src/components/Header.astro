---
// Starlight's header with two project buttons, GitHub and Support, that stay in the header
// on every width (Starlight hides its social icons on phones). On pages without a sidebar
// (the landing) phones get no menu, so a language link sits next to them there.
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import { Icon } from '@astrojs/starlight/components';
import { links, strings } from '../landing';

const { lang: routeLang, hasSidebar } = Astro.locals.starlightRoute;
const lang = routeLang === 'en' ? 'en' : 'ru';
const t = strings[lang].header;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const rest = Astro.url.pathname.slice(base.length) || '/';
const otherPath = lang === 'en' ? rest.replace(/^\/en(\/|$)/, '/') : `/en${rest}`;
const other = { href: `${base}${otherPath}`, label: lang === 'en' ? 'RU' : 'EN', lang: lang === 'en' ? 'ru' : 'en' };
---

<div class="header">
	<div class="title-wrapper sl-flex">
		<SiteTitle />
	</div>
	<div class="sl-flex print:hidden">
		<Search />
	</div>
	<div class="end sl-flex print:hidden">
		<nav class="project" aria-label={t.label}>
			<a class="pbtn pbtn-github" href={links.github} aria-label={t.githubLabel}>
				<Icon name="github" size="1.125rem" />
				<span class="pbtn-text">GitHub</span>
			</a>
			<a class="pbtn pbtn-support" href={links.sponsor} aria-label={t.supportLabel}>
				<Icon name="heart" size="1rem" />
				<span class="pbtn-text">{t.support}</span>
			</a>
			{
				!hasSidebar && (
					<a class="pbtn pbtn-lang" href={other.href} hreflang={other.lang} lang={other.lang} aria-label={t.otherLanguage}>
						{other.label}
					</a>
				)
			}
		</nav>
		<div class="sl-hidden md:sl-flex right-group">
			<ThemeSelect />
			<LanguageSelect />
		</div>
	</div>
</div>

<style>
	@layer starlight.core {
		.header {
			display: flex;
			gap: var(--sl-nav-gap);
			justify-content: space-between;
			align-items: center;
			height: 100%;
		}

		.title-wrapper {
			overflow: clip;
			padding: 0.25rem;
			margin: -0.25rem;
			min-width: 0;
		}

		.end,
		.right-group {
			gap: 1rem;
			align-items: center;
		}

		@media (min-width: 50rem) {
			:global(:root[data-has-sidebar]) {
				--__sidebar-pad: calc(2 * var(--sl-nav-pad-x));
			}
			:global(:root:not([data-has-toc])) {
				--__toc-width: 0rem;
			}
			.header {
				--__sidebar-width: max(0rem, var(--sl-content-inline-start, 0rem) - var(--sl-nav-pad-x));
				--__main-column-fr: calc(
					(
							100% + var(--__sidebar-pad, 0rem) - var(--__toc-width, var(--sl-sidebar-width)) -
								(2 * var(--__toc-width, var(--sl-nav-pad-x))) - var(--sl-content-inline-start, 0rem) -
								var(--sl-content-width)
						) / 2
				);
				display: grid;
				grid-template-columns:
					minmax(calc(var(--__sidebar-width) + max(0rem, var(--__main-column-fr) - var(--sl-nav-gap))), auto)
					1fr
					auto;
				align-content: center;
			}
			.right-group {
				padding-inline-start: 1rem;
				border-inline-start: 1px solid var(--mk-hairline-strong);
			}
		}
	}

	.project {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.pbtn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		height: 2.5rem;
		min-width: 2.5rem;
		padding-inline: 0.875rem;
		border-radius: 10px;
		font-size: 0.875rem;
		font-weight: 600;
		line-height: 1;
		text-decoration: none;
		white-space: nowrap;
		transition:
			background-color 0.2s var(--mk-ease),
			border-color 0.2s var(--mk-ease),
			color 0.2s var(--mk-ease);
	}

	.pbtn:focus-visible {
		outline: 2px solid var(--mk-accent);
		outline-offset: 2px;
	}

	.pbtn-github,
	.pbtn-lang {
		border: 1px solid var(--mk-hairline-strong);
		background: var(--mk-surface);
		color: var(--mk-ink);
	}

	.pbtn-github:hover,
	.pbtn-lang:hover {
		border-color: color-mix(in srgb, var(--mk-ink) 35%, transparent);
	}

	.pbtn-support {
		border: 1px solid color-mix(in srgb, var(--mk-accent) 45%, transparent);
		background: var(--mk-accent-soft);
		color: var(--mk-accent-text);
	}

	.pbtn-support :global(svg) {
		color: var(--mk-accent);
	}

	.pbtn-support:hover {
		background: color-mix(in srgb, var(--mk-accent) 22%, var(--mk-accent-soft));
		border-color: var(--mk-accent);
	}

	.pbtn-lang {
		padding-inline: 0.625rem;
		font-family: var(--sl-font-mono);
		font-size: 0.8125rem;
	}

	@media (min-width: 50rem) {
		.pbtn-lang {
			display: none;
		}
	}

	/* Phones: GitHub becomes an icon button, Support keeps its label. */
	@media (max-width: 49.99rem) {
		.pbtn {
			height: 2.25rem;
			min-width: 2.25rem;
		}
		.pbtn-github {
			padding-inline: 0;
		}
		.pbtn-github .pbtn-text {
			display: none;
		}
		.pbtn-support {
			padding-inline: 0.625rem;
		}
	}

	/* The narrowest phones keep the Support label and drop the wordmark next to the logo. */
	@media (max-width: 26rem) {
		.pbtn-support {
			padding-inline: 0.5rem;
			gap: 0.375rem;
		}
		.title-wrapper :global(.site-title span) {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip: rect(0 0 0 0);
			white-space: nowrap;
		}
	}
</style>
