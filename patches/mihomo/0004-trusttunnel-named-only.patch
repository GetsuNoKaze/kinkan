diff --git a/transport/trusttunnel/named.go b/transport/trusttunnel/named.go
new file mode 100644
index 00000000..b38c5c5d
--- /dev/null
+++ b/transport/trusttunnel/named.go
@@ -0,0 +1,53 @@
+package trusttunnel
+
+import (
+	"crypto/x509"
+	"errors"
+	"strings"
+
+	"github.com/metacubex/tls"
+)
+
+// ErrNoCertificateForName fails a handshake that does not name the server.
+var ErrNoCertificateForName = errors.New("trusttunnel: no certificate for this name")
+
+// NamedOnly hands the certificate out only to a client that names one of the names in
+// it, a wildcard covering one label. Without SNI or with a stranger's name the handshake
+// fails with internal_error, as on a Caddy site configured under its domain alone. A
+// certificate without DNS names (one for an IP address) is handed to anyone.
+func NamedOnly(get func(*tls.ClientHelloInfo) (*tls.Certificate, error)) func(*tls.ClientHelloInfo) (*tls.Certificate, error) {
+	return func(hello *tls.ClientHelloInfo) (*tls.Certificate, error) {
+		c, err := get(hello)
+		if err != nil || c == nil || len(c.Certificate) == 0 {
+			return c, err
+		}
+		leaf := c.Leaf
+		if leaf == nil {
+			if leaf, err = x509.ParseCertificate(c.Certificate[0]); err != nil {
+				return c, nil
+			}
+		}
+		if len(leaf.DNSNames) == 0 || len(leaf.IPAddresses) > 0 {
+			return c, nil
+		}
+		if hello != nil && coversName(leaf.DNSNames, hello.ServerName) {
+			return c, nil
+		}
+		return nil, ErrNoCertificateForName
+	}
+}
+
+func coversName(names []string, name string) bool {
+	name = strings.ToLower(strings.TrimSuffix(name, "."))
+	if name == "" {
+		return false
+	}
+	i := strings.IndexByte(name, '.')
+	for _, n := range names {
+		n = strings.ToLower(n)
+		if n == name || (i > 0 && n == "*"+name[i:]) {
+			return true
+		}
+	}
+	return false
+}
diff --git a/transport/trusttunnel/named_test.go b/transport/trusttunnel/named_test.go
new file mode 100644
index 00000000..b65770a9
--- /dev/null
+++ b/transport/trusttunnel/named_test.go
@@ -0,0 +1,51 @@
+package trusttunnel
+
+import (
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"math/big"
+	"net"
+	"testing"
+	"time"
+
+	"github.com/metacubex/tls"
+)
+
+func namedTestCert(t *testing.T, dns []string, ips []net.IP) *tls.Certificate {
+	t.Helper()
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	tpl := &x509.Certificate{SerialNumber: big.NewInt(1), Subject: pkix.Name{CommonName: "node"}, DNSNames: dns, IPAddresses: ips,
+		NotBefore: time.Now().Add(-time.Hour), NotAfter: time.Now().Add(time.Hour)}
+	der, err := x509.CreateCertificate(rand.Reader, tpl, tpl, &key.PublicKey, key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return &tls.Certificate{Certificate: [][]byte{der}, PrivateKey: key}
+}
+
+func TestNamedOnly(t *testing.T) {
+	named := namedTestCert(t, []string{"node.example", "*.site.example"}, nil)
+	get := NamedOnly(func(*tls.ClientHelloInfo) (*tls.Certificate, error) { return named, nil })
+	for sni, want := range map[string]bool{
+		"node.example": true, "NODE.example.": true, "a.site.example": true,
+		"": false, "203.0.113.5": false, "other.example": false, "site.example": false, "a.b.site.example": false,
+	} {
+		c, err := get(&tls.ClientHelloInfo{ServerName: sni})
+		if want && (err != nil || c != named) {
+			t.Errorf("SNI %q: %v %v, want the certificate", sni, c, err)
+		}
+		if !want && err == nil {
+			t.Errorf("SNI %q: the certificate was handed out", sni)
+		}
+	}
+	byIP := namedTestCert(t, nil, []net.IP{net.ParseIP("203.0.113.5")})
+	if c, err := NamedOnly(func(*tls.ClientHelloInfo) (*tls.Certificate, error) { return byIP, nil })(&tls.ClientHelloInfo{}); err != nil || c != byIP {
+		t.Errorf("a certificate for an address: %v %v, want it for anyone", c, err)
+	}
+}
